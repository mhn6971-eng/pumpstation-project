{
  "name": "pumpstation-monitoring",
  "private": true,
  "scripts": {
    "dev": "node scripts/serve.mjs dev",
    "preview": "node scripts/init-db.mjs && node scripts/serve.mjs dev",
    "preview:lan": "node scripts/init-db.mjs && node scripts/serve.mjs dev --host lan",
    "stackblitz": "node scripts/init-db.mjs && node scripts/serve.mjs dev --webpack --host lan",
    "db:init": "node scripts/init-db.mjs",
    "build": "next build",
    "start": "node scripts/serve.mjs start",
    "start:lan": "node scripts/serve.mjs start --host lan",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "doctor": "node scripts/doctor.mjs",
    "test:audit": "node audit/audit1.mjs && node audit/audit2.mjs && node audit/audit3.mjs && node audit/audit4.mjs && node audit/audit5.mjs && node audit/audit6.mjs",
    "test:perf": "node audit/perf.mjs",
    "test": "npm run typecheck && npm run test:audit",
    "db:pg-init": "node scripts/pg-init.mjs",
    "db:pg-dump": "node scripts/pg-dump.mjs",
    "db:import": "node scripts/pg-import-json.mjs",
    "mirror": "node scripts/mirror-backup.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "next": "^16.4.5",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.4.5",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  },
  "version": "1.4.1"
}
